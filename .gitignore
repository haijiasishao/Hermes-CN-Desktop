# Rust
/target

# Node
node_modules/
web/dist/

# Tauri generated (desktop schemas etc) — but commit the Android project
/gen/*
!/gen/android/
# Android: commit the generated project (gradle wrapper etc), ignore build output
/gen/android/app/build/
/gen/android/.gradle/
/gen/android/local.properties
/gen/android/app/src/main/assets/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
.claude/
*.swp
*.swo

# Build artifacts
static/runtime/
static/bundled-runtime/*
!static/bundled-runtime/.gitkeep
static/dashboard/*
!static/dashboard/.gitkeep
static/bundled-skills/*
!static/bundled-skills/.gitkeep
static/bundled-plugins/*
!static/bundled-plugins/.gitkeep

# Local logs
.codex-logs/
.codex-tmp/

# Runtime release signing private key (gh secret RUNTIME_SIGN_PRIVATE_KEY_PEM)
.runtime-keys/

# Python build script cache
__pycache__/

